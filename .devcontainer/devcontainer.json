{
  "name": "Case Reader",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "bash scripts/setup.sh",
  "containerEnv": {
    "HOST": "0.0.0.0"
  },
  "forwardPorts": [8400],
  "portsAttributes": {
    "8400": {
      "label": "Case Reader",
      "onAutoForward": "openPreview"
    }
  }
}
